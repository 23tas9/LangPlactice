{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build C++",
            "type": "cppbuild",
            "command": "g++",
            "args": [
                "${workspaceFolder}\\${relativeFileDirname}\\${fileBasenameNoExtension}.cpp",
                "-o",
                "${workspaceFolder}\\${relativeFileDirname}\\${fileBasenameNoExtension}.out",
                "-std=c++2b"
            ],
			"options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
        }
    ]
}