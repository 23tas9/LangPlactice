// 作業ファイルをrun.batに渡す
{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "開いているファイルを実行",

            // type: nodeでcmd.exeを使用
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "${env:ComSpec}",
            "runtimeArgs": [
                "/c",
                "call",
                "${workspaceFolder}\\.vscode\\run.bat",
                "${file}"
            ],
            "cwd": "${fileDirname}",
            // 出力をデバッグ コンソールに表示する
            "console": "internalConsole",
            "outputCapture": "std",
            "internalConsoleOptions": "openOnSessionStart"
        }
    ]
}
